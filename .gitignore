# Package manager directories
node_modules/

# TypeScript incremental build cache
*.tsbuildinfo

# MagicMirror core source cache (populated by sync-mmcore-source.ts)
mmcore-source/

# Build and coverage output
dist/
client/generated/
client/webfonts/
client/styles/font-awesome.css
client/styles/magicmirror-fonts.css
client/styles/magicmirror-stage.css
shims/generated/
coverage/
.runtime-cache/

# Test artifacts and reports
test-results/
.playwright-mcp/
playwright-report/
.vitest-attachments/
tests/**/__screenshots__/
docs/screenshots/

# Local archives
*.zip
*.tgz

# Debug and error logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# CodeQL
codeql-db/
codeql*

# OS-specific files
.DS_Store
.secrets

# Vendored upstream files (auto-synced via npm run build:02-sync-analyzer)
server/vendor/check-modules/dependency-usage.ts
server/vendor/check-modules/missing-dependency-rule.ts
server/vendor/check-modules/module-analyzer.ts
server/vendor/check-modules/rule-registry.ts
server/vendor/check-modules/eslint-testconfig.ts
server/vendor/check-modules/http-import-check.ts
server/vendor/check-modules/javascript-check.ts
server/vendor/check-modules/workflow-version-policy.ts
server/vendor/check-modules/workflow-yaml-check.ts
scripts/upstream-snapshots/*.upstream

# Agent related ignores
memory/
.claude/
.github/copilot-instructions.md
HANDOFF.md
CLAUDE.md
TODO.md

# IDE-specific files
.vscode/
# Superpowers working files (brainstorm sessions, specs, plans): local only
